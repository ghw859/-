# 通义千问 API 密钥（在阿里云百炼平台获取）
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 使用的模型（可选，默认 qwen-turbo）
# 可选值: qwen-turbo / qwen-plus / qwen-max / qwen-max-longcontext
QWEN_MODEL=qwen-turbo

# Redis 连接（对话上下文存储）
REDIS_URL=redis://localhost:6379/0

# 对话上下文 TTL（秒），默认 30 分钟
CHAT_HISTORY_TTL=1800

# 对话上下文最大保留轮数（一问一答算 2 条），默认 20 轮
CHAT_HISTORY_MAX=20

# 热力图历史数据天数（用于 sklearn 训练），默认 14 天
HEATMAP_HISTORY_DAYS=14

# 热力图缓存 TTL（秒），默认 1 天
HEATMAP_CACHE_TTL=86400

# 热力图随机种子基准（保证确定性输出）
HEATMAP_SEED_BASE=42
