# docker-compose 根环境变量（复制为 .env 后生效；.env 已加入 .gitignore 严禁提交）
# MySQL root 密码（mysql 服务初始化 + backend 服务连接共用）
DB_PASSWORD=root

# JWT 签名密钥（backend 服务）
JWT_SECRET=LingMouZhiBanTong2026SecretKeyForJWTAtLeast32Chars

# 通义千问 API 密钥不在这里配：编辑 lingmou_ai/.env（参考 lingmou_ai/.env.example）
# 未配置时 AI 对话/诊断自动走规则降级，服务可正常启动
