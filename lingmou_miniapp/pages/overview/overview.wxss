/* pages/overview/overview.wxss */
.overview-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 顶部欢迎栏 */
.welcome-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 86, 219, 0.25);
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.welcome-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.welcome-badge {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
}

.badge-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 700;
}

/* 统计卡片 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-blue { border-top: 6rpx solid #3b82f6; }
.stat-purple { border-top: 6rpx solid #8b5cf6; }
.stat-green { border-top: 6rpx solid #10b981; }
.stat-amber { border-top: 6rpx solid #f59e0b; }

.stat-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #1e293b;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
}

/* 标题图标 */
.title-icon {
  width: 12rpx;
  height: 32rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}
.heatmap-icon { background: #06b6d4; }
.ai-icon { background: #8b5cf6; }
.pie-icon { background: #10b981; }
.bar-icon { background: #f59e0b; }
.radar-icon { background: #6366f1; }
.history-icon { background: #3b82f6; }

.ai-badge {
  margin-left: auto;
  background: #ede9fe;
  color: #7c3aed;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

/* 热力图 */
.heatmap-container {
  margin-top: 20rpx;
  overflow-x: auto;
}

.heatmap-header {
  display: flex;
  align-items: center;
  padding-bottom: 12rpx;
}

.heatmap-corner {
  width: 140rpx;
  flex-shrink: 0;
}

.heatmap-time {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #94a3b8;
  min-width: 60rpx;
}

.heatmap-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.heatmap-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #475569;
  font-weight: 600;
}

.heatmap-cell {
  flex: 1;
  min-width: 60rpx;
  height: 60rpx;
  margin: 0 2rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heatmap-value {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 600;
}

.heatmap-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.legend-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
}

/* AI诊断 */
.diagnosis-card {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), rgba(59, 130, 246, 0.05));
}

.diagnosis-content {
  margin-top: 20rpx;
  min-height: 200rpx;
  padding: 24rpx;
  background: rgba(139, 92, 246, 0.06);
  border-radius: 20rpx;
  border: 1rpx solid rgba(139, 92, 246, 0.15);
}

.diagnosis-text {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.8;
}

.typing-cursor {
  border-right: 4rpx solid #8b5cf6;
}

.diagnosis-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.diagnosis-btn {
  background: #8b5cf6;
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* 图表区域 */
.chart-container {
  margin-top: 20rpx;
}

.pie-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pie-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pie-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}

.pie-label {
  font-size: 28rpx;
  color: #475569;
  flex: 1;
}

.pie-value {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 700;
}

/* 柱状图 */
.bar-chart {
  margin-top: 20rpx;
}

.bar-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.bar-label {
  width: 80rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: right;
  margin-right: 16rpx;
}

.bar-track {
  flex: 1;
  height: 32rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 16rpx;
  transition: width 0.6s ease;
}

.bar-value {
  width: 60rpx;
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 700;
  margin-left: 16rpx;
}

/* 雷达图（简化为进度条） */
.radar-chart {
  margin-top: 20rpx;
}

.radar-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.radar-label {
  width: 160rpx;
  font-size: 24rpx;
  color: #64748b;
  text-align: right;
  margin-right: 16rpx;
}

.radar-track {
  flex: 1;
  height: 28rpx;
  background: #f1f5f9;
  border-radius: 14rpx;
  overflow: hidden;
}

.radar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  border-radius: 14rpx;
}

.radar-value {
  width: 60rpx;
  font-size: 24rpx;
  color: #1e293b;
  font-weight: 700;
  margin-left: 16rpx;
}

/* 最近记录 */
.recent-list {
  margin-top: 20rpx;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recent-voucher {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.recent-time {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 快捷入口 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon { background: linear-gradient(135deg, #3b82f6, #06b6d4); }
.form-icon { background: linear-gradient(135deg, #10b981, #34d399); }
.progress-icon { background: linear-gradient(135deg, #8b5cf6, #a78bfa); }
.chat-icon { background: linear-gradient(135deg, #f59e0b, #fbbf24); }

.quick-item text {
  font-size: 22rpx;
  color: #475569;
}

/* 老年模式 */
.elderly-mode .stat-value {
  font-size: 52rpx;
}

.elderly-mode .welcome-title {
  font-size: 48rpx;
}
