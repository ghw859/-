/* pages/history/history.wxss */
.history-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #1e40af, #3b82f6);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.2);
}

.header-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 区块链校验 */
.chain-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.chain-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.chain-ok {
  background: #d1fae5;
  color: #047857;
}

.chain-fail {
  background: #fee2e2;
  color: #dc2626;
}

.chain-loading {
  background: #fef3c7;
  color: #d97706;
  font-size: 24rpx;
}

.chain-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.chain-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

/* 筛选 */
.filter-card {
  padding: 24rpx;
}

.filter-group {
  margin-bottom: 20rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
  display: block;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #f1f5f9;
  font-weight: 500;
}

.chip-active {
  background: #1a56db !important;
  color: #ffffff !important;
}

/* 存证列表 */
.audit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.audit-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.audit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.audit-sn {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  font-family: monospace;
}

.audit-body {
  margin-bottom: 16rpx;
}

.audit-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.audit-label {
  font-size: 24rpx;
  color: #64748b;
}

.audit-value {
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 500;
}

.audit-hash {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  overflow: hidden;
}

.hash-label {
  font-size: 20rpx;
  color: #6366f1;
  font-weight: 700;
  flex-shrink: 0;
}

.hash-value {
  font-size: 20rpx;
  color: #94a3b8;
  font-family: monospace;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx;
  font-size: 28rpx;
  color: #94a3b8;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 88%;
  max-width: 640rpx;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.modal-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.modal-body {
  padding: 32rpx;
  overflow-y: auto;
  flex: 1;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #64748b;
  flex-shrink: 0;
  width: 160rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 500;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.detail-hash {
  font-size: 22rpx !important;
  font-family: monospace;
  color: #6366f1 !important;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e2e8f0;
}

.modal-cancel { flex: 1; }
.modal-export { flex: 1; }
