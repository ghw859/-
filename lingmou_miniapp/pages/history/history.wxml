<!-- pages/history/history.wxml -->
<view class="history-page {{elderlyMode ? 'elderly-mode' : ''}}">

  <!-- 标题栏 -->
  <view class="page-header">
    <view class="header-icon history-header-icon"></view>
    <view>
      <view class="header-title">区块链存证历史</view>
      <view class="header-sub">金融级加密 · SHA-256 哈希链 · 全程可追溯</view>
    </view>
  </view>

  <!-- 区块链校验状态 -->
  <view class="card chain-card">
    <view class="chain-status">
      <view class="chain-icon {{chainIntact === true ? 'chain-ok' : chainIntact === false ? 'chain-fail' : 'chain-loading'}}">
        <text wx:if="{{chainIntact === true}}">✓</text>
        <text wx:elif="{{chainIntact === false}}">!</text>
        <text wx:else>...</text>
      </view>
      <view class="chain-text">
        <text class="chain-title">{{chainIntact === true ? '存证链完整' : chainIntact === false ? '存证链异常' : '正在校验...'}}</text>
        <text class="chain-desc">{{chainIntact === true ? '所有存证记录的哈希链路验证通过' : chainIntact === false ? '检测到哈希断链，请联系管理员' : '正在连接后端验证哈希链路'}}</text>
      </view>
    </view>
  </view>

  <!-- 筛选条 -->
  <view class="card filter-card">
    <view class="filter-group">
      <text class="filter-label">类型</text>
      <scroll-view scroll-x class="filter-scroll">
        <view class="filter-chips">
          <view class="chip {{filterBizType === item.value ? 'chip-active' : ''}}" wx:for="{{bizTypes}}" wx:key="value" bindtap="onFilterBizType" data-value="{{item.value}}">{{item.label}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="filter-group">
      <text class="filter-label">状态</text>
      <view class="filter-chips">
        <view class="chip {{filterStatus === 'all' ? 'chip-active' : ''}}" bindtap="onFilterStatus" data-value="all">全部</view>
        <view class="chip {{filterStatus === '已提交' ? 'chip-active' : ''}}" bindtap="onFilterStatus" data-value="已提交">已提交</view>
        <view class="chip {{filterStatus === '已完成' ? 'chip-active' : ''}}" bindtap="onFilterStatus" data-value="已完成">已完成</view>
        <view class="chip {{filterStatus === '已取消' ? 'chip-active' : ''}}" bindtap="onFilterStatus" data-value="已取消">已取消</view>
      </view>
    </view>

    <view class="filter-group">
      <text class="filter-label">时间</text>
      <view class="filter-chips">
        <view class="chip {{filterTime === item.value ? 'chip-active' : ''}}" wx:for="{{timeOptions}}" wx:key="value" bindtap="onFilterTime" data-value="{{item.value}}">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 存证列表 -->
  <view class="audit-list">
    <view class="audit-card" wx:for="{{filteredLogs}}" wx:key="id" bindtap="viewDetail" data-log="{{item}}">
      <view class="audit-header">
        <view class="audit-sn">{{item.sn}}</view>
        <view class="badge {{item.status === '已完成' ? 'badge-completed' : item.status === '已取消' ? 'badge-canceled' : 'badge-active'}}">
          {{item.status}}
        </view>
      </view>

      <view class="audit-body">
        <view class="audit-row">
          <text class="audit-label">业务类型</text>
          <text class="audit-value">{{item.bizTypeName || item.bizType}}</text>
        </view>
        <view class="audit-row">
          <text class="audit-label">客户</text>
          <text class="audit-value">{{item.userName || '未填写'}}</text>
        </view>
        <view class="audit-row">
          <text class="audit-label">时间</text>
          <text class="audit-value">{{item.timestamp}}</text>
        </view>
      </view>

      <!-- 哈希显示 -->
      <view class="audit-hash">
        <text class="hash-label">SHA-256</text>
        <text class="hash-value">{{item.hash}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="card empty-state" wx:if="{{filteredLogs.length === 0 && !loading}}">
    <text>{{auditLogs.length === 0 ? '暂无存证记录' : '没有符合筛选条件的存证记录'}}</text>
  </view>

  <!-- 详情弹窗 -->
  <view class="modal-mask" wx:if="{{detailVisible}}" bindtap="closeDetail">
    <view class="modal-content" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">存证详情</text>
        <text class="modal-close" bindtap="closeDetail">✕</text>
      </view>

      <view class="modal-body" wx:if="{{selectedLog}}">
        <view class="detail-row">
          <text class="detail-label">流水号</text>
          <text class="detail-value">{{selectedLog.sn}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">业务类型</text>
          <text class="detail-value">{{selectedLog.bizTypeName || selectedLog.bizType}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">状态</text>
          <text class="detail-value">{{selectedLog.status}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">提交时间</text>
          <text class="detail-value">{{selectedLog.timestamp}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">客户姓名</text>
          <text class="detail-value">{{selectedLog.userName || '未填写'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">身份证号</text>
          <text class="detail-value">{{selectedLog.idCardMasked || '未填写'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">手机号</text>
          <text class="detail-value">{{selectedLog.phoneMasked || '未填写'}}</text>
        </view>
        <view class="detail-row" wx:if="{{selectedLog.voucherNum}}">
          <text class="detail-label">凭证号</text>
          <text class="detail-value">{{selectedLog.voucherNum}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">存证哈希</text>
          <text class="detail-value detail-hash">{{selectedLog.hash}}</text>
        </view>
        <view class="detail-row" wx:if="{{selectedLog.hashValid !== undefined}}">
          <text class="detail-label">哈希校验</text>
          <text class="detail-value {{selectedLog.hashValid ? 'text-success' : 'text-danger'}}">
            {{selectedLog.hashValid ? '✓ 自洽' : '✗ 异常'}}
          </text>
        </view>
      </view>

      <view class="modal-footer">
        <button class="btn-outline modal-cancel" bindtap="closeDetail">关闭</button>
        <button class="btn-primary modal-export" bindtap="exportSingle">导出凭证</button>
      </view>
    </view>
  </view>

</view>
