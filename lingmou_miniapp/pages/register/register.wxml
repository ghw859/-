<!-- pages/register/register.wxml -->
<view class="register-page">
  <view class="form-card">
    <view class="form-title">注册新账号</view>

    <view class="form-item">
      <text class="form-label">姓名</text>
      <input
        class="input-field"
        placeholder="请输入真实姓名"
        value="{{name}}"
        data-field="name"
        bindinput="onInput"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <text class="form-label">身份证号</text>
      <input
        class="input-field"
        placeholder="请输入18位身份证号"
        value="{{idCard}}"
        data-field="idCard"
        bindinput="onInput"
        maxlength="18"
      />
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="input-field"
        type="number"
        placeholder="请输入11位手机号"
        value="{{phone}}"
        data-field="phone"
        bindinput="onInput"
        maxlength="11"
      />
    </view>

    <view class="form-item">
      <text class="form-label">密码</text>
      <input
        class="input-field"
        password="{{true}}"
        placeholder="6-20位密码"
        value="{{password}}"
        data-field="password"
        bindinput="onInput"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <text class="form-label">确认密码</text>
      <input
        class="input-field"
        password="{{true}}"
        placeholder="请再次输入密码"
        value="{{confirmPassword}}"
        data-field="confirmPassword"
        bindinput="onInput"
        maxlength="20"
      />
    </view>

    <button class="btn-primary register-btn" bindtap="handleRegister" loading="{{loading}}" disabled="{{loading}}">
      <text>注册并登录</text>
    </button>

    <view class="back-link" bindtap="goBack">
      <text>已有账号？返回登录</text>
    </view>
  </view>
</view>
