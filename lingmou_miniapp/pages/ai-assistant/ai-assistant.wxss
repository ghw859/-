/* pages/ai-assistant/ai-assistant.wxss */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f4f8;
}

/* 头部 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e2e8f0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ai-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.header-sub {
  font-size: 20rpx;
  color: #64748b;
}

.header-action {
  background: #f1f5f9;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

/* 隐私提示 */
.privacy-bar {
  display: flex;
  justify-content: center;
  padding: 12rpx;
  background: #ecfdf5;
  border-bottom: 1rpx solid #d1fae5;
}

.privacy-bar text {
  font-size: 22rpx;
  color: #059669;
  font-weight: 600;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.scroll-bottom {
  height: 1rpx;
}

.msg-item {
  display: flex;
  margin-bottom: 32rpx;
  gap: 16rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-content {
  flex: 1;
  max-width: 80%;
}

.msg-content-user {
  display: flex;
  justify-content: flex-end;
}

/* AI 思维链 */
.cot-area {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.cot-faded {
  opacity: 0.45;
}

.cot-title {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.cot-step {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.step-num {
  font-size: 20rpx;
  color: #06b6d4;
  font-weight: 700;
  flex-shrink: 0;
}

.step-text {
  font-size: 20rpx;
  color: #475569;
  font-family: monospace;
}

/* AI 气泡 */
.ai-bubble {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx 20rpx 20rpx 4rpx;
  padding: 24rpx 28rpx;
  display: inline-block;
  max-width: 100%;
}

.ai-text {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.7;
}

/* 用户气泡 */
.user-bubble {
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  border-radius: 20rpx 20rpx 4rpx 20rpx;
  padding: 24rpx 28rpx;
  display: inline-block;
}

.user-bubble text {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.6;
}

/* 快捷指令 */
.quick-cmds {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.quick-cmd {
  background: #dbeafe;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #1a56db;
  font-weight: 600;
}

/* 输入区 */
.input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.msg-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f1f5f9;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #1e293b;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  color: #ffffff;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.send-disabled {
  background: #cbd5e1 !important;
  color: #94a3b8 !important;
}

/* 老年模式 */
.elderly-mode .header-title {
  font-size: 32rpx;
}

.elderly-mode .ai-text {
  font-size: 34rpx;
}

.elderly-mode .user-bubble text {
  font-size: 34rpx;
}

.elderly-mode .msg-input {
  font-size: 34rpx;
  height: 80rpx;
}

.elderly-mode .send-btn {
  font-size: 34rpx;
}
