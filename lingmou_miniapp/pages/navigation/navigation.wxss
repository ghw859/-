/* pages/navigation/navigation.wxss */
.nav-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #1a56db, #06b6d4);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 86, 219, 0.2);
}

.header-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.nav-header-icon {
  background: rgba(255, 255, 255, 0.2);
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 筛选条 */
.filter-bar {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.filter-group {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-label {
  width: 80rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  flex-shrink: 0;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #f1f5f9;
  font-weight: 500;
}

.chip-active {
  background: #1a56db !important;
  color: #ffffff !important;
}

.chip-free.chip-active { background: #10b981 !important; }
.chip-moderate.chip-active { background: #f59e0b !important; }
.chip-busy.chip-active { background: #ef4444 !important; }

.sort-picker {
  flex: 1;
}

.picker-display {
  padding: 16rpx 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1e293b;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 32rpx;
  color: #94a3b8;
  font-size: 26rpx;
}

/* 网点列表 */
.branch-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.branch-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
}

.branch-stripe {
  width: 8rpx;
  flex-shrink: 0;
}

.stripe-free { background: #10b981; }
.stripe-moderate { background: #f59e0b; }
.stripe-busy { background: #ef4444; }

.branch-content {
  flex: 1;
  padding: 28rpx;
}

.branch-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.branch-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.branch-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.branch-address {
  font-size: 24rpx;
  color: #64748b;
  flex: 1;
}

.branch-distance {
  font-size: 24rpx;
  color: #3b82f6;
  font-weight: 600;
  flex-shrink: 0;
}

.wait-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.wait-time {
  display: flex;
  flex-direction: column;
}

.wait-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.wait-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #1e293b;
}

.wait-trend {
  flex-shrink: 0;
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 60rpx;
}

.trend-bar {
  width: 16rpx;
  border-radius: 4rpx;
  min-height: 8rpx;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.service-tag {
  font-size: 20rpx;
  color: #3b82f6;
  background: #dbeafe;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.branch-actions {
  display: flex;
  gap: 16rpx;
}

.book-btn {
  flex: 1;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 88%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.modal-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.modal-body {
  padding: 32rpx;
}

.modal-branch-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a56db;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
}

.slot-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e2e8f0;
}

.modal-cancel {
  flex: 1;
}

.modal-confirm {
  flex: 1;
}
