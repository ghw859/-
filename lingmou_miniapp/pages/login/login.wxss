/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #1a56db 0%, #3b82f6 40%, #f0f4f8 70%);
}

/* 品牌区 */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.brand-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.brand-icon {
  font-size: 36rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.brand-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 表单卡片 */
.form-card {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.form-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.form-desc {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

/* 微信用户预览 */
.wx-user-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f0f4f8, #e8f0fe);
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}

.wx-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.wx-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

/* 头像占位 */
.wx-avatar-placeholder {
  background: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-avatar-placeholder text {
  font-size: 32rpx;
  font-weight: 900;
  color: #94a3b8;
}

/* 资料完善区 */
.profile-toggle {
  text-align: center;
  font-size: 24rpx;
  color: #3b82f6;
  padding: 16rpx 0 24rpx;
}

.profile-panel {
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.profile-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.profile-item:last-child {
  margin-bottom: 0;
}

.profile-label {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
}

.avatar-btn {
  width: 96rpx !important;
  height: 96rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 50% !important;
  background: #e2e8f0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  overflow: hidden;
  line-height: 1 !important;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 96rpx;
  height: 96rpx;
}

.avatar-tip {
  font-size: 20rpx;
  color: #64748b;
}

/* 微信登录按钮 */
.wx-login-btn {
  width: 100% !important;
  margin-bottom: 32rpx;
  background: linear-gradient(135deg, #07c160, #06ad56) !important;
}

.wx-btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-icon-text {
  font-size: 24rpx;
  font-weight: 900;
  color: #ffffff;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e2e8f0;
}

.divider-text {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 安全提示 */
.security-tips {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #d1fae5;
  color: #059669;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.register-link {
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

/* 老年模式切换 */
.elderly-toggle {
  margin-top: 40rpx;
  font-size: 26rpx;
  text-align: center;
}

/* 老年模式放大 */
.elderly-mode .brand-title {
  font-size: 52rpx;
}

.elderly-mode .brand-subtitle {
  font-size: 32rpx;
}

.elderly-mode .form-title {
  font-size: 44rpx;
}

.elderly-mode .form-desc {
  font-size: 30rpx;
}

.elderly-mode .wx-name {
  font-size: 36rpx;
}

.elderly-mode .tip-item {
  font-size: 28rpx;
}
