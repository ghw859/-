/* pages/progress/progress.wxss */
.progress-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #8b5cf6, #6366f1);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.2);
}

.header-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  flex: 1;
}

.header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.refresh-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #ffffff;
  flex-shrink: 0;
}

/* 预约选择条 */
.appt-selector {
  margin-bottom: 24rpx;
}

.appt-scroll {
  white-space: nowrap;
}

.appt-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  min-width: 120rpx;
}

.appt-chip-active {
  border-color: #8b5cf6;
  background: #ede9fe;
}

.appt-chip-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.appt-chip-status {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

/* 空状态 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 32rpx;
}

/* 标题图标 */
.title-icon {
  width: 12rpx;
  height: 32rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}

.step-icon { background: #8b5cf6; }

/* 步骤条 */
.step-bar {
  margin-top: 32rpx;
  position: relative;
  padding: 0 20rpx 40rpx;
}

.step-track {
  position: absolute;
  top: 28rpx;
  left: 40rpx;
  right: 40rpx;
  height: 6rpx;
  background: #e2e8f0;
  border-radius: 3rpx;
  overflow: hidden;
}

.step-line-active {
  height: 100%;
  background: linear-gradient(90deg, #8b5cf6, #6366f1);
  border-radius: 3rpx;
  transition: width 0.5s ease;
}

.step-nodes {
  display: flex;
  justify-content: space-between;
  position: relative;
}

.step-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  z-index: 1;
}

.node-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 4rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 700;
}

.node-active .node-circle {
  background: #8b5cf6;
  border-color: #8b5cf6;
  color: #ffffff;
}

.node-label {
  font-size: 22rpx;
  color: #64748b;
}

/* 状态信息 */
.status-info {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.status-title-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #1e293b;
}

.status-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #64748b;
}

/* 凭证信息 */
.voucher-detail {
  margin-top: 20rpx;
}

.voucher-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.voucher-row:last-child {
  border-bottom: none;
}

.voucher-label {
  font-size: 26rpx;
  color: #64748b;
}

.voucher-value {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 700;
  font-family: monospace;
}

/* 操作面板 */
.action-card {
  text-align: center;
  padding: 40rpx;
}

.action-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.action-desc {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 24rpx;
}

.action-card .btn-primary {
  width: 100% !important;
}

/* 已失效 */
.expired-card {
  text-align: center;
  padding: 40rpx;
  background: #f8fafc;
}

.expired-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 12rpx;
}

.expired-desc {
  font-size: 26rpx;
  color: #94a3b8;
}

/* 评价 */
.review-card {
  text-align: center;
  padding: 40rpx;
}

.review-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.review-stars {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.star {
  font-size: 56rpx;
  color: #e2e8f0;
}

.star-active {
  color: #f59e0b;
}

.review-card .btn-primary {
  width: 100% !important;
}

.review-done {
  text-align: center;
  font-size: 30rpx;
  color: #10b981;
  font-weight: 600;
  padding: 32rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.cancel-btn { flex: 1; }
.refresh-one-btn { flex: 1; }
