<!-- pages/qrcode/qrcode.wxml -->
<view class="qrcode-page {{elderlyMode ? 'elderly-mode' : ''}}">

  <!-- 标题栏 -->
  <view class="page-header">
    <view class="header-icon qr-header-icon"></view>
    <view>
      <view class="header-title">业务直通码</view>
      <view class="header-sub">AI预检 · 区块链存证 · 到店扫码激活</view>
    </view>
  </view>

  <!-- 空闲态 -->
  <view class="card idle-card" wx:if="{{genState === 'idle'}}">
    <view class="idle-icon">QR</view>
    <view class="idle-title">暂无直通码</view>
    <view class="idle-desc">请先填写预填单，AI 预检通过后将自动签发直通码</view>
    <button class="btn-primary" bindtap="goPreForm">
      <text>去填写预填单</text>
    </button>
  </view>

  <!-- 加载态 -->
  <view class="card" wx:if="{{genState === 'loading'}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">AI 正在预检材料...</view>
    <view class="loading-sub">正在校验必要要素，生成区块链存证</view>
  </view>

  <!-- 成功态 -->
  <view class="card success-card" wx:if="{{genState === 'success' && passCode}}">
    <view class="success-header">
      <view class="success-badge"><text>签发成功</text></view>
      <view class="audit-status" wx:if="{{passCode.auditSynced}}">
        <text>区块链存证已同步</text>
      </view>
    </view>

    <!-- 二维码图片 -->
    <view class="qr-image-container">
      <image
        wx:if="{{qrImageUrl && !qrImageError}}"
        class="qr-image"
        src="{{qrImageUrl}}"
        mode="aspectFit"
        binderror="onQrError"
      />
      <view class="qr-fallback" wx:else>
        <text class="qr-fallback-title">{{passCode.voucherNum}}</text>
        <text class="qr-fallback-tip">二维码加载失败，可向柜员出示此凭证号</text>
      </view>
    </view>

    <!-- 凭证信息 -->
    <view class="voucher-info">
      <view class="voucher-row">
        <text class="voucher-label">直通码</text>
        <text class="voucher-value">{{passCode.voucherNum}}</text>
      </view>
      <view class="voucher-row">
        <text class="voucher-label">流水号</text>
        <text class="voucher-value">{{passCode.sn}}</text>
      </view>
      <view class="voucher-row">
        <text class="voucher-label">业务类型</text>
        <text class="voucher-value">{{passCode.bizTypeName}}</text>
      </view>
    </view>

    <!-- 倒计时 -->
    <view class="countdown-bar">
      <text class="countdown-label">有效剩余时间</text>
      <text class="countdown-time">{{countdownText}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="success-actions">
      <button class="btn-outline save-btn" bindtap="downloadQRCode">
        <text>保存二维码</text>
      </button>
      <button class="btn-primary progress-btn" bindtap="goToProgress">
        <text>查看进度</text>
      </button>
    </view>
  </view>

  <!-- 预检拒绝 -->
  <view class="card rejected-card" wx:if="{{genState === 'rejected'}}">
    <view class="rejected-icon">!</view>
    <view class="rejected-title">AI 预检未通过</view>
    <view class="rejected-desc">以下必要材料缺失，请补充后重新提交：</view>
    <view class="missing-list">
      <view class="missing-item" wx:for="{{missingLabels}}" wx:key="*this">
        <text class="missing-dot"></text>
        <text>{{item}}</text>
      </view>
    </view>
    <button class="btn-primary" bindtap="goPreForm">
      <text>返回补充材料</text>
    </button>
  </view>

  <!-- 错误态 -->
  <view class="card error-card" wx:if="{{genState === 'error'}}">
    <view class="error-icon">!</view>
    <view class="error-title">签发失败</view>
    <view class="error-desc">{{errorMsg}}</view>
    <button class="btn-primary" bindtap="retryGenerate">
      <text>重试</text>
    </button>
  </view>

  <!-- AI 推荐网点 -->
  <view class="card" wx:if="{{genState === 'idle' || genState === 'success'}}">
    <view class="section-title">
      <view class="title-icon recommend-icon"></view>
      <text>AI 智能推荐网点</text>
    </view>
    <view class="recommend-list">
      <view class="recommend-item" wx:for="{{recommendedBranches}}" wx:key="id" bindtap="goToNavigation">
        <view class="recommend-info">
          <text class="recommend-name">{{item.name}}</text>
          <text class="recommend-wait">约 {{item.waitTime}} 分钟</text>
        </view>
        <view class="badge {{item.status === 'free' ? 'badge-free' : item.status === 'moderate' ? 'badge-moderate' : 'badge-busy'}}">
          {{item.status === 'free' ? '畅通' : item.status === 'moderate' ? '适中' : '繁忙'}}
        </view>
      </view>
    </view>
  </view>

</view>
