/* pages/qrcode/qrcode.wxss */
.qrcode-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.2);
}

.header-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 空闲态 */
.idle-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.idle-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: #e0e7ff;
  color: #6366f1;
  font-size: 40rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.idle-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.idle-desc {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

/* 加载态 */
.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #6366f1;
  border-radius: 50%;
  margin: 40rpx auto 24rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.loading-sub {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 40rpx;
}

/* 成功态 */
.success-card {
  background: linear-gradient(135deg, rgba(209, 250, 229, 0.3), rgba(255, 255, 255, 1));
}

.success-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.success-badge {
  background: #d1fae5;
  color: #047857;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.audit-status {
  background: #ede9fe;
  color: #7c3aed;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.qr-image-container {
  display: flex;
  justify-content: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e2e8f0;
}

.qr-image {
  width: 360rpx;
  height: 360rpx;
}

.qr-fallback {
  width: 360rpx;
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.qr-fallback-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a56db;
  word-break: break-all;
  text-align: center;
  padding: 0 24rpx;
}

.qr-fallback-tip {
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
  padding: 0 32rpx;
}

.voucher-info {
  margin-bottom: 24rpx;
}

.voucher-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.voucher-row:last-child {
  border-bottom: none;
}

.voucher-label {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 600;
}

.voucher-value {
  font-size: 30rpx;
  color: #1e293b;
  font-weight: 700;
  font-family: monospace;
}

.countdown-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fef3c7;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.countdown-label {
  font-size: 26rpx;
  color: #92400e;
  font-weight: 600;
}

.countdown-time {
  font-size: 40rpx;
  font-weight: 800;
  color: #d97706;
  font-family: monospace;
}

.success-actions {
  display: flex;
  gap: 20rpx;
}

.save-btn { flex: 1; }
.progress-btn { flex: 1; }

/* 拒绝态 */
.rejected-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.rejected-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fee2e2;
  color: #dc2626;
  font-size: 48rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.rejected-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.rejected-desc {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 24rpx;
}

.missing-list {
  width: 100%;
  margin-bottom: 32rpx;
}

.missing-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #475569;
}

.missing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ef4444;
  flex-shrink: 0;
}

/* 错误态 */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fee2e2;
  color: #dc2626;
  font-size: 48rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.error-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 32rpx;
}

/* 推荐网点 */
.title-icon {
  width: 12rpx;
  height: 32rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}

.recommend-icon { background: #06b6d4; }

.recommend-list {
  margin-top: 20rpx;
}

.recommend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.recommend-item:last-child {
  border-bottom: none;
}

.recommend-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recommend-name {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.recommend-wait {
  font-size: 24rpx;
  color: #94a3b8;
}
