/* pages/preform/preform.wxss */
.preform-page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #10b981, #06b6d4);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.2);
}

.header-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.header-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

/* 标题图标 */
.title-icon {
  width: 12rpx;
  height: 32rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}
.parse-icon { background: #8b5cf6; }
.biz-icon { background: #3b82f6; }
.info-icon { background: #06b6d4; }
.cash-icon { background: #f59e0b; }
.card-icon { background: #10b981; }
.transfer-icon { background: #6366f1; }
.deposit-icon { background: #f97316; }
.fx-icon { background: #a855f7; }

.ai-badge {
  margin-left: auto;
  background: #ede9fe;
  color: #7c3aed;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

/* 解析区 */
.parse-area {
  margin-top: 20rpx;
}

.parse-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.6;
  box-sizing: border-box;
}

.parse-status {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
}

.status-text {
  font-size: 24rpx;
  color: #0369a1;
}

.parse-actions {
  margin-top: 20rpx;
}

.parse-actions .btn-primary {
  width: 100% !important;
}

/* 业务类型选择 */
.biz-type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.biz-type-card {
  padding: 24rpx 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #475569;
  font-weight: 600;
}

.biz-active {
  background: #dbeafe !important;
  border-color: #3b82f6 !important;
  color: #1a56db !important;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
}

/* 业务卡片 */
.biz-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 1), rgba(248, 250, 252, 0.8));
}

/* 操作按钮 */
.form-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
}

.reset-btn {
  flex: 1;
}

.submit-btn {
  flex: 2;
}
